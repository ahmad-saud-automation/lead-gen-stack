{
  "id": "demo-waterfall",
  "name": "Director waterfall",
  "note": "The demo recipe (2026-11-06), the same ladder the sample screen shows: contact 1's address from the sheet (no cost), then contact 1 guessed and verified, then the email finder; contact 2 the same way; then the company address. Labels start with as-is / enriched / fallback on purpose: core/lead_record.email_status_for reads the winner's first word.",
  "updated": "2026-11-06",
  "people": [
    {"label": "as-is contact 1", "name_from": ["contact_1_name"], "name_pick": "whole",
     "address_from": "contact_1_email", "only_if": {}, "never_if_same_as": [],
     "how": [{"method": "use_as_is", "verify": "no_check"}]},
    {"label": "enriched contact 1", "name_from": ["contact_1_name"], "name_pick": "whole",
     "address_from": "", "only_if": {}, "never_if_same_as": [],
     "how": [{"method": "guess_patterns", "patterns": "first_then_full", "verify": "must_pass"},
             {"method": "icypeas_domain", "verify": "must_pass"},
             {"method": "icypeas_company", "verify": "must_pass", "note_if_domain_mismatch": true}]},
    {"label": "as-is contact 2", "name_from": ["contact_2_name"], "name_pick": "whole",
     "address_from": "contact_2_email", "only_if": {}, "never_if_same_as": [],
     "how": [{"method": "use_as_is", "verify": "no_check"}]},
    {"label": "enriched contact 2", "name_from": ["contact_2_name"], "name_pick": "whole",
     "address_from": "", "only_if": {}, "never_if_same_as": [],
     "how": [{"method": "guess_patterns", "patterns": "first_then_full", "verify": "must_pass"},
             {"method": "icypeas_domain", "verify": "must_pass"}]},
    {"label": "fallback company address", "name_from": "", "name_pick": "whole",
     "address_from": "email", "only_if": {}, "never_if_same_as": [],
     "how": [{"method": "use_as_is", "verify": "no_check"}]}
  ],
  "stop": {"stop_when": "first_pass", "skip_row_if": {}, "last_resort": false},
  "write": {"email_to": "found_email", "person_to": "found_for", "method_to": "found_by",
            "status_to": "email_status", "write_when": "always"},
  "limits": {"per_run": 30, "per_day": 0, "daily_spend_cap_usd": 0,
             "search_same_person_once": true, "push_to": ""}
}
