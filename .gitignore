# runtime data — leads, results, logs, saved API keys (never commit: PII + secrets)
data/*
# except the made-up demo data the demo mode and the evals read
!data/demo/
.env

# scratch expectation lists written while checking a finder by hand. They hold real
# lead email addresses, so they are PII and never committed.
nl_expect.txt
*_expect.txt

# The LIVE campaign config. It holds real Instantly campaign ids, which identify the
# running campaigns, and it gains a new one every time a campaign is switched on - so
# tracking it means a new real id is committed on every change. Work from
# config/campaigns.example.json instead: copy it to config/campaigns.json and fill in
# your own ids. 2026-10-12: real ids were removed from the unpushed commits for this.
config/campaigns.json

# generated by the Schedule tab (local paths + chosen flags)
run-scheduled.bat

# Google service-account credentials — never commit
*service-account*.json
*credentials*.json

# python
__pycache__/
*.pyc
.venv/
venv/

# Next.js screens: node_modules and .next are junctions into C:\ClaudeDeps\leadgen-web
# (see start-app.bat)
web/node_modules
web/.next
# a second test pair's own build output (launch entries engine-test-2 / web-dev-2)
web/.next-s3
web/tsconfig.tsbuildinfo

# written automatically before any config change, so the previous version survives
config/*.backup.json
